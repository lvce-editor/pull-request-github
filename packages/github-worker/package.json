{
  "name": "@lvce-editor/pull-request-github-worker",
  "version": "0.0.0-dev",
  "private": true,
  "description": "GitHub worker for the pull request extension",
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "main": "src/githubWorkerMain.ts",
  "scripts": {
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "test:watch": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --watch"
  },
  "jest": {
    "injectGlobals": false,
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "testMatch": [
      "**/test/**/*.test.ts"
    ],
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 85,
        "lines": 80
      }
    }
  },
  "dependencies": {
    "@lvce-editor/pull-request-shared": "*"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@lvce-editor/rpc": "^6.18.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12"
  }
}
