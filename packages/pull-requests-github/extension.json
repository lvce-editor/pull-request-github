{
  "id": "github.pull-requests",
  "browser": "dist/pullRequestWorkerMain.js",
  "isolated": true,
  "contentSecurityPolicy": ["default-src 'none'", "connect-src https://api.github.com", "script-src 'self'"],
  "activation": [
    "onView:github.pullRequests",
    "onCommand:PullRequestsGithub.openOnGitHub",
    "onCommand:PullRequestsGithub.refresh",
    "onCommand:PullRequestsGithub.show",
    "onCommand:PullRequestsGithub.clearPullRequestData",
    "onCommand:PullRequestsGithub.setPullRequestData",
    "onCommand:PullRequestsGithub.setPullRequestError",
    "onCommand:PullRequestsGithub.setPullRequestListData",
    "onCommand:PullRequestsGithub.setPullRequestListError",
    "onCommand:PullRequestsGithub.setPullRequestListResponse",
    "onCommand:PullRequestsGithub.setPullRequestResponse"
  ],
  "commands": [
    {
      "id": "PullRequestsGithub.show",
      "label": "GitHub Pull Requests: Focus on Pull Requests View"
    },
    {
      "id": "PullRequestsGithub.refresh",
      "label": "GitHub Pull Requests: Refresh Pull Request"
    },
    {
      "id": "PullRequestsGithub.openOnGitHub",
      "label": "GitHub Pull Requests: Open Pull Request on GitHub"
    },
    {
      "id": "PullRequestsGithub.clearPullRequestData",
      "label": "Clear Pull Requests GitHub Mock Data"
    },
    {
      "id": "PullRequestsGithub.setPullRequestData",
      "label": "Set Pull Requests GitHub Mock Data"
    },
    {
      "id": "PullRequestsGithub.setPullRequestError",
      "label": "Set Pull Requests GitHub Mock Error"
    },
    {
      "id": "PullRequestsGithub.setPullRequestListData",
      "label": "Set Pull Requests GitHub Mock List Data"
    },
    {
      "id": "PullRequestsGithub.setPullRequestListError",
      "label": "Set Pull Requests GitHub Mock List Error"
    },
    {
      "id": "PullRequestsGithub.setPullRequestListResponse",
      "label": "Set Pull Requests GitHub Mock List Response"
    },
    {
      "id": "PullRequestsGithub.setPullRequestResponse",
      "label": "Set Pull Requests GitHub Mock Response"
    }
  ],
  "views": [
    {
      "css": "media/pullRequests.css",
      "id": "github.pullRequests",
      "title": "Pull Requests",
      "icon": "media/git-pull-request.svg",
      "kind": "virtualDom"
    }
  ]
}
